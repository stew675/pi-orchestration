{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": false,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@earendil-works/pi-coding-agent": ["./.pi-host/@earendil-works/pi-coding-agent/dist/index.d.ts"],
      "@earendil-works/pi-tui": ["./.pi-host/@earendil-works/pi-tui/dist/index.d.ts"],
      "@earendil-works/pi-ai": ["./.pi-host/@earendil-works/pi-ai/dist/index.d.ts"],
      "typebox": ["./.pi-host/typebox/build/index.d.mts"]
    }
  },
  "include": ["*.ts"],
  "exclude": ["node_modules"]
}
